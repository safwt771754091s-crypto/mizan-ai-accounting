# ===== Supabase =====
# أنشئ مشروعاً على https://supabase.com ثم انسخ القيم من Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة يُستخدم في السكربتات الإدارية فقط. لا تضعه في متغيرات NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ===== المساعد الذكي =====
# متوافق مع أي مزود بواجهة Chat Completions (OpenAI، OpenRouter، Groq، DeepSeek، Ollama...)
# المفتاح يُقرأ على الخادم فقط. لا تستخدم بادئة NEXT_PUBLIC_ معه.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# اختياري: حد طول الرد ومهلة الطلب بالمللي ثانية
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=20000
# للتحقق من الاتصال: npm run ai:check

# ===== التشغيل =====
# demo: تشغيل المنصة ببيانات تجريبية بدون Supabase (افتراضي عند غياب الإعدادات)
# supabase: إلزام Supabase Auth وقاعدة البيانات
RAKAZ_DATA_MODE=demo
# سر توقيع جلسات الوضع التجريبي (32 حرفاً على الأقل)
RAKAZ_DEMO_SESSION_SECRET=

# ===== مركز المقترحات → GitHub Issues (اختياري) =====
# عند غياب التوكن يبقى زر «إرسال إلى GitHub» معطّلاً برسالة واضحة، ويعمل الفرز والاعتماد طبيعياً.
# استخدم fine-grained token بصلاحية Issues: write على المستودع فقط. يُقرأ على الخادم ولا يُرسل للمتصفح.
GITHUB_ISSUES_TOKEN=
# المستودع الهدف (owner/repo). الافتراضي: safwt771754091-crypto/mizan-ai-accounting
GITHUB_ISSUES_REPO=
# تصنيفات اختيارية تُطبّق على الـ Issue، مفصولة بفواصل. يجب أن تكون موجودة مسبقاً في المستودع.
GITHUB_ISSUES_LABELS=

# Android TWA (اختياري — يُملأ بعد إنشاء مفتاح التوقيع)
ANDROID_APP_PACKAGE=ai.rakaz.twa
# بصمة SHA-256 لشهادة التوقيع، مفصولة بفواصل عند تعدد المفاتيح
ANDROID_SHA256_CERT_FINGERPRINTS=

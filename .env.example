# ===== Supabase =====
# أنشئ مشروعاً على https://supabase.com ثم انسخ القيم من Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة يُستخدم في السكربتات الإدارية فقط. لا تضعه في متغيرات NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ===== المساعد الذكي =====
# متوافق مع أي مزود بواجهة Chat Completions (OpenAI، OpenRouter، Groq، DeepSeek، Ollama...)
# المفتاح يُقرأ على الخادم فقط. لا تستخدم بادئة NEXT_PUBLIC_ معه.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# اختياري: حد طول الرد ومهلة الطلب بالمللي ثانية
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=20000
# للتحقق من الاتصال: npm run ai:check

# ===== التشغيل =====
# demo: تشغيل المنصة ببيانات تجريبية بدون Supabase (افتراضي عند غياب الإعدادات)
# supabase: إلزام Supabase Auth وقاعدة البيانات
RAKAZ_DATA_MODE=demo
# سر توقيع جلسات الوضع التجريبي (32 حرفاً على الأقل)
RAKAZ_DEMO_SESSION_SECRET=
